# Plantilla del .env del backend. El .env real NO se sube a git.
# setup.sh / win_setup.sh copian este archivo a webSIGAE/BackEnd/.env, así que
# los valores de abajo son los de DESARROLLO (base local creada por el setup).
# Si agregas una variable nueva, agrégala aquí (con un valor de ejemplo, nunca uno real).
#
# ── PRODUCCIÓN ───────────────────────────────────────────────────────────────
# En el servidor se crea un .env aparte (chmod 600, dueño: el usuario de pm2)
# con TODOS los valores reales. Con NODE_ENV=production el servidor NO arranca
# si falta alguna variable marcada [obligatoria en producción].
# Nunca reutilices aquí ni en producción los valores de desarrollo.

# Entorno. Sin NODE_ENV el backend corre en modo desarrollo.
# NODE_ENV=production   (producción; ecosystem.config.js también lo fija)
PORT=3000
# Interfaz en la que escucha. En producción, por defecto 127.0.0.1 (solo Nginx).
# HOST=127.0.0.1

# ── Base de datos ─────────────────── [obligatoria en producción]
# Producción: endpoint de la RDS y el usuario sigae_app (permisos acotados).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sigae
DB_PASSWORD=sigae123
DB_NAME=sigae
# true = TLS verificado contra la CA de Amazon RDS. Producción: true.
DB_SSL=false

# ── Sesiones (JWT) ────────────────── [obligatoria en producción]
# Producción: mínimo 32 caracteres aleatorios, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=un_secreto_muy_largo_y_seguro

# ── Frontend y CORS ───────────────── [FRONTEND_URL obligatoria en producción]
# URL pública del frontend: se usa en los enlaces de recuperación de contraseña.
# Producción: https://tu-dominio (sin / final).
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos por CORS, separados por coma. Si se omite, se usa FRONTEND_URL.
# CORS_ORIGINS=https://tu-dominio

# ── Fotos de perfil (CU20) ────────── [obligatoria en producción]
# Carpeta donde se guardan y desde donde se sirven las fotos subidas.
# Producción: /var/sigae/uploads (fuera del repo; respaldarla aparte).
# Si se omite, se usa webSIGAE/BackEnd/uploads (desarrollo).
# UPLOADS_DIR=/var/sigae/uploads

# ── Exportación a PNG (Puppeteer) ─── [obligatoria en producción]
# Chromium del sistema. Producción: /usr/bin/chromium (apt install chromium).
# Si se omite, Puppeteer usa el navegador que descarga npm install.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ── Correo SMTP (recuperación de contraseña, CU14) ── [obligatoria en producción]
# Sin SMTP_HOST, en desarrollo el enlace se muestra en la consola del backend.
# En EC2 el puerto 25 está bloqueado: usa 587 (STARTTLS) o 465 (SMTP_SECURE=true).
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario_smtp
# SMTP_PASS=clave_smtp
# EMAIL_FROM="SIGAE <no-responder@tu-dominio>"
